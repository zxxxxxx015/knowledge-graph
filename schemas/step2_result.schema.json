            "original_mapping"
          ],
          "properties": {
            "column_index": {
              "type": "integer",
              "minimum": 0
            },
            "processed_range": {
              "$ref": "#/$defs/step1/$defs/range"
            },
            "text": {
              "type": "string"
            },
            "original_mapping": {
              "$ref": "#/$defs/step1/$defs/original_mapping"
            }
          }
        },
        "cell": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "column_index",
            "header_text",
            "header_range",
            "processed_range",
            "text",
            "original_mapping"
          ],
          "properties": {
            "column_index": {
              "type": "integer",
              "minimum": 0
            },
            "header_text": {
              "type": "string"
            },
            "header_range": {
              "$ref": "#/$defs/step1/$defs/range"
            },
            "processed_range": {
              "$ref": "#/$defs/step1/$defs/range"
            },
            "text": {
              "type": "string"
            },
            "original_mapping": {
              "$ref": "#/$defs/step1/$defs/original_mapping"
            }
          }
        },
        "row": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "row_index",
            "processed_range",
            "text",
            "original_mapping",
            "cells"
          ],
          "properties": {
            "row_index": {
              "type": "integer",
              "minimum": 0
            },
            "processed_range": {
              "$ref": "#/$defs/step1/$defs/range"
            },
            "text": {
              "type": "string"
            },
            "original_mapping": {
              "$ref": "#/$defs/step1/$defs/original_mapping"
            },
            "cells": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/step1/$defs/cell"
              }
            }
          }
        },
        "table": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "table_id",
            "processed_range",
            "text",
            "original_mapping",
