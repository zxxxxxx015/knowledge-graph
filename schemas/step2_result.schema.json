            "separator",
            "rows"
          ],
          "properties": {
            "table_id": {
              "type": "string",
              "minLength": 1
            },
            "processed_range": {
              "$ref": "#/$defs/step1/$defs/range"
            },
            "text": {
              "type": "string"
            },
            "original_mapping": {
              "$ref": "#/$defs/step1/$defs/original_mapping"
            },
            "header": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "processed_range",
                "text",
                "original_mapping",
                "cells"
              ],
              "properties": {
                "processed_range": {
                  "$ref": "#/$defs/step1/$defs/range"
                },
                "text": {
                  "type": "string"
                },
                "original_mapping": {
                  "$ref": "#/$defs/step1/$defs/original_mapping"
                },
                "cells": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/step1/$defs/header_cell"
                  }
                }
              }
            },
            "separator": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "processed_range",
                "text",
                "original_mapping"
              ],
              "properties": {
                "processed_range": {
                  "$ref": "#/$defs/step1/$defs/range"
                },
                "text": {
                  "type": "string"
                },
                "original_mapping": {
                  "$ref": "#/$defs/step1/$defs/original_mapping"
                }
              }
            },
            "rows": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/step1/$defs/row"
              }
            }
          }
        },
        "statement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "statement_id",
            "source_ref",
            "processed_range",
            "text",
            "original_mapping",
            "heading_context",
            "step0_trace",
            "kind",
            "boundary_reason",
            "boundary_detail"
          ],
          "properties": {
            "statement_id": {
              "type": "string",
              "pattern": "^ks_[0-9a-f]{64}$"
            },
            "source_ref": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "processed_range": {
              "$ref": "#/$defs/step1/$defs/range"
            },
            "text": {
              "type": "string"
            },
            "original_mapping": {
              "$ref": "#/$defs/step1/$defs/original_mapping"
            },
            "heading_context": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/step1/$defs/heading"
              }
            },
            "step0_trace": {
              "$ref": "#/$defs/step1/$defs/trace"
            },
            "kind": {
              "enum": [
                "prose",
                "list",
                "table"
              ]
            },
            "boundary_reason": {
              "enum": [
                "complete_sentence",
                "independent_sentence",
                "lead_list_dependency",
                "causal_dependency",
                "causal_chain",
                "table_row",
                "table_dependency"
              ]
            },
            "boundary_detail": {
              "type": "string",
              "minLength": 1
            },
            "table_context": {
              "$ref": "#/$defs/step1/$defs/table"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "table"
                  }
                }
              },
              "then": {
                "required": [
                  "table_context"
                ]
              },
              "else": {
                "not": {
                  "required": [
                    "table_context"
                  ]
                }
              }
            }
          ]
        },
        "region": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "processed_range",
            "text",
            "original_mapping",
            "heading_context",
            "step0_trace",
            "reason_code",
            "reason"
          ],
          "properties": {
            "processed_range": {
              "$ref": "#/$defs/step1/$defs/range"
