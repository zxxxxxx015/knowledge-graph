{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "input",
    "source",
    "step1_snapshot",
    "extraction_decisions",
    "statement_reviews",
    "knowledge_items",
    "occurrences",
    "warnings",
    "status"
  ],
  "properties": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step1_json_path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "step1_json_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "source": {
      "$ref": "#/$defs/step1/properties/source"
    },
    "step1_snapshot": {
      "$ref": "#/$defs/step1"
    },
    "extraction_decisions": {
      "$ref": "#/$defs/llm"
    },
    "statement_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statement_id",
          "decision",
          "basis",
          "reason",
          "knowledge_item_ids",
          "pending_candidates"
        ],
        "properties": {
          "statement_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "decision": {
            "enum": [
              "kept",
              "filtered",
              "needs_review"
            ]
          },
          "basis": {
            "enum": [
              "knowledge_bearing",
              "no_knowledge_value",
              "uncertain"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "knowledge_item_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "pending_candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "candidate_id",
                "surface_text",
                "start",
                "end",
                "unit_kind",
                "resolution",
                "reason",
                "statement_local_range",
                "processed_range",
                "original_mapping",
                "step0_trace",
                "table_cell_ref"
              ],
              "properties": {
                "candidate_id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "surface_text": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 0
                },
                "unit_kind": {
                  "enum": [
                    "concept",
                    "condition",
                    "behavior",
                    "state_change",
                    "causal_statement"
                  ]
                },
                "resolution": {
                  "enum": [
                    "confirmed",
                    "pending"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "statement_local_range": {
                  "$ref": "#/$defs/range"
                },
                "processed_range": {
                  "$ref": "#/$defs/range"
                },
                "original_mapping": {
                  "$ref": "#/$defs/step1/$defs/original_mapping"
                },
                "step0_trace": {
                  "$ref": "#/$defs/step1/$defs/trace"
                },
                "table_cell_ref": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "table_id",
                        "row_index",
                        "column_index",
                        "cell_processed_range",
                        "header_text",
                        "header_range"
                      ],
                      "properties": {
                        "table_id": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "\\S"
                        },
                        "row_index": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "column_index": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "cell_processed_range": {
                          "$ref": "#/$defs/range"
                        },
                        "header_text": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "\\S"
                        },
                        "header_range": {
                          "$ref": "#/$defs/range"
                        }
                      }
                    }
                  ]
                },
                "evidence_quote": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          }
        }
      }
    },
    "knowledge_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "knowledge_item_id",
          "canonical_label",
          "disambiguation",
          "merge_reason",
          "identity_evidence",
          "identity_input",
          "occurrence_ids",
          "source_ref"
        ],
        "properties": {
          "knowledge_item_id": {
            "type": "string",
            "pattern": "^ki_[0-9a-f]{64}$"
          },
          "canonical_label": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "disambiguation": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "merge_reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "identity_evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/llm/$defs/evidence"
            },
            "minItems": 1
          },
          "identity_input": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version",
              "source_sha256",
              "anchors"
            ],
            "properties": {
              "version": {
                "const": "step2-concept-anchors-v1"
              },
              "source_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "anchors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "statement_id",
                    "start",
                    "end"
                  ],
                  "properties": {
                    "statement_id": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "start": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                },
                "minItems": 1,
                "uniqueItems": true
              }
            }
          },
          "occurrence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "source_ref": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "occurrences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "occurrence_id",
          "knowledge_item_id",
          "statement_id",
          "source_ref",
          "surface_text",
          "statement_local_range",
          "processed_range",
          "original_mapping",
          "step0_trace",
          "table_cell_ref"
        ],
        "properties": {
          "occurrence_id": {
            "type": "string",
            "pattern": "^occ_[0-9a-f]{64}$"
          },
          "knowledge_item_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "statement_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "source_ref": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "surface_text": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "statement_local_range": {
            "$ref": "#/$defs/range"
          },
          "processed_range": {
            "$ref": "#/$defs/range"
          },
          "original_mapping": {
            "$ref": "#/$defs/step1/$defs/original_mapping"
          },
          "step0_trace": {
            "$ref": "#/$defs/step1/$defs/trace"
          },
          "table_cell_ref": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "table_id",
                  "row_index",
                  "column_index",
                  "cell_processed_range",
                  "header_text",
                  "header_range"
                ],
                "properties": {
                  "table_id": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "row_index": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "column_index": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "cell_processed_range": {
                    "$ref": "#/$defs/range"
                  },
                  "header_text": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "header_range": {
                    "$ref": "#/$defs/range"
                  }
                }
              }
            ]
          },
          "evidence_quote": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_state",
        "prompt_id",
        "prompt_sha256",
        "llm_call_count",
        "llm_retry_count",
        "reviewed_statement_count",
        "kept_count",
        "filtered_count",
        "needs_review_count",
        "knowledge_item_count",
        "occurrence_count"
      ],
      "properties": {
        "execution_state": {
          "enum": [
            "completed",
            "completed_with_warnings"
          ]
        },
        "prompt_id": {
          "const": "prompts/step2.md"
        },
        "prompt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "llm_call_count": {
          "type": "integer",
          "minimum": 0
        },
        "llm_retry_count": {
          "type": "integer",
          "minimum": 0
        },
        "reviewed_statement_count": {
          "type": "integer",
          "minimum": 0
        },
        "kept_count": {
          "type": "integer",
          "minimum": 0
        },
        "filtered_count": {
          "type": "integer",
          "minimum": 0
        },
        "needs_review_count": {
          "type": "integer",
          "minimum": 0
        },
        "knowledge_item_count": {
          "type": "integer",
          "minimum": 0
        },
        "occurrence_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Self-contained embedded Step 1 and LLM schemas; Python validates cross references and reproduces all derived fields.",
  "$defs": {
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "step1": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "source",
        "original_text",
        "processed_text",
        "step0_provenance",
        "structure",
        "knowledge_statements",
        "unhandled_regions",
        "warnings",
        "status"
      ],
      "properties": {
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "step0_json_path",
            "sha256",
            "size_bytes"
