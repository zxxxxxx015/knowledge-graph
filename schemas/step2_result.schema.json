              "properties": {
                "execution_state": {
                  "enum": [
                    "completed",
                    "completed_with_warnings",
                    "llm_failed"
                  ]
                },
                "prompt_id": {
                  "const": "prompts/step0.md"
                },
                "prompt_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "llm_call_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "llm_retry_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "candidate_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "applied_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "rejected_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "unresolved_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "warning_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "llm_error_kind": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "$defs": {
            "range": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start",
                "end"
              ],
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "reported_range": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start",
                "end"
              ],
              "properties": {
                "start": {
                  "type": "integer"
                },
                "end": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "range": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "original_mapping": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "source_range",
            "text",
            "reason"
          ],
          "properties": {
            "status": {
              "enum": [
                "available",
                "unavailable"
              ]
            },
            "source_range": {
              "anyOf": [
                {
                  "$ref": "#/$defs/step1/$defs/range"
                },
                {
                  "type": "null"
                }
              ]
            },
            "text": {
              "type": [
                "string",
                "null"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "available"
                  }
                }
              },
              "then": {
                "properties": {
                  "source_range": {
                    "$ref": "#/$defs/step1/$defs/range"
                  },
                  "text": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "null"
                  }
                }
              },
              "else": {
                "properties": {
                  "source_range": {
                    "type": "null"
                  },
                  "text": {
                    "type": "null"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          ]
        },
        "heading": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "heading_id",
            "parent_id",
            "level",
            "title",
            "processed_range",
            "text",
            "original_mapping"
          ],
          "properties": {
            "heading_id": {
              "type": "string",
              "minLength": 1
            },
            "parent_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "level": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6
            },
            "title": {
              "type": "string"
            },
            "processed_range": {
              "$ref": "#/$defs/step1/$defs/range"
            },
            "text": {
              "type": "string"
            },
            "original_mapping": {
              "$ref": "#/$defs/step1/$defs/original_mapping"
            }
          }
        },
        "trace": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "replacement_indexes",
            "unresolved_indexes",
            "warning_indexes",
            "unlocated_unresolved_indexes",
            "unlocated_warning_indexes"
          ],
          "properties": {
            "replacement_indexes": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "uniqueItems": true
            },
            "unresolved_indexes": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "uniqueItems": true
            },
            "warning_indexes": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "uniqueItems": true
            },
            "unlocated_unresolved_indexes": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "uniqueItems": true
            },
            "unlocated_warning_indexes": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "uniqueItems": true
            }
          }
        },
        "header_cell": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "column_index",
