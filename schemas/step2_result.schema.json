          "properties": {
            "headings": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/step1/$defs/heading"
              }
            },
            "tables": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/step1/$defs/table"
              }
            },
            "protected_regions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "processed_range",
                  "reason_code"
                ],
                "properties": {
                  "processed_range": {
                    "$ref": "#/$defs/step1/$defs/range"
                  },
                  "reason_code": {
                    "enum": [
                      "heading_context",
                      "table_structure",
                      "table_pending",
                      "code_block",
                      "unsupported_markdown"
                    ]
                  }
                }
              }
            }
          }
        },
        "knowledge_statements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step1/$defs/statement"
          }
        },
        "unhandled_regions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step1/$defs/region"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "status": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "execution_state",
            "prompt_id",
            "prompt_sha256",
            "llm_call_count",
            "llm_retry_count",
            "statement_count",
            "unhandled_count"
          ],
          "properties": {
            "execution_state": {
              "enum": [
                "completed",
                "completed_with_warnings"
              ]
            },
            "prompt_id": {
              "const": "prompts/step1.md"
            },
            "prompt_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "llm_call_count": {
              "type": "integer",
              "minimum": 0
            },
            "llm_retry_count": {
              "type": "integer",
              "minimum": 0
            },
            "statement_count": {
              "type": "integer",
              "minimum": 0
            },
            "unhandled_count": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      },
      "$defs": {
        "step0": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "original_text",
            "processed_text",
            "replacements",
            "unresolved",
            "warnings",
            "status"
          ],
          "properties": {
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "document_type",
                "sha256",
                "size_bytes",
                "char_count",
                "encoding"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "document_type": {
                  "enum": [
                    "md",
                    "txt"
                  ]
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "size_bytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "char_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "encoding": {
                  "const": "utf-8"
                }
              }
            },
            "original_text": {
              "type": "string"
            },
            "processed_text": {
              "type": "string"
            },
            "replacements": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "original_text",
                  "replacement_text",
                  "source_range",
                  "processed_range",
                  "evidence_text",
                  "evidence_range",
                  "reference_type",
                  "reason"
                ],
                "properties": {
                  "original_text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "replacement_text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source_range": {
                    "$ref": "#/$defs/step1/$defs/step0/$defs/range"
                  },
                  "processed_range": {
                    "$ref": "#/$defs/step1/$defs/step0/$defs/range"
                  },
                  "evidence_text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence_range": {
                    "$ref": "#/$defs/step1/$defs/step0/$defs/range"
                  },
                  "reference_type": {
                    "enum": [
                      "pronoun",
                      "demonstrative",
                      "elliptical_name"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "unresolved": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "original_text",
                  "source_range",
                  "reported_text",
                  "reported_range",
                  "proposed_replacement",
                  "reason_code",
                  "reason",
                  "origin",
                  "candidate_index"
                ],
                "properties": {
                  "original_text": {
                    "type": "string"
                  },
                  "source_range": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/step1/$defs/step0/$defs/range"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "reported_text": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "reported_range": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/step1/$defs/step0/$defs/reported_range"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "proposed_replacement": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "reason_code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "origin": {
                    "enum": [
                      "llm",
                      "python_validation",
                      "llm_failure"
                    ]
                  },
                  "candidate_index": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  }
                }
              }
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "code",
                  "message",
                  "source_range",
                  "candidate_index"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source_range": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/step1/$defs/step0/$defs/range"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "candidate_index": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
