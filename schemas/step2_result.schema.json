              "$ref": "#/$defs/step1/$defs/original_mapping"
            },
            "heading_context": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/step1/$defs/heading"
              }
            },
            "step0_trace": {
              "$ref": "#/$defs/step1/$defs/trace"
            },
            "reason_code": {
              "enum": [
                "heading_context",
                "table_structure",
                "table_pending",
                "code_block",
                "unsupported_markdown",
