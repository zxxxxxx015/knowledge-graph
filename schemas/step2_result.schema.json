              "required": [
                "execution_state",
                "prompt_id",
                "prompt_sha256",
                "llm_call_count",
                "llm_retry_count",
                "candidate_count",
                "applied_count",
                "rejected_count",
                "unresolved_count",
                "warning_count",
                "llm_error_kind"
