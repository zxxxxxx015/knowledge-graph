            "size_bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "source": {
          "$ref": "#/$defs/step1/$defs/step0/properties/source"
        },
        "original_text": {
          "type": "string"
        },
        "processed_text": {
          "type": "string"
        },
        "step0_provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "replacements",
            "unresolved",
            "warnings",
            "status"
          ],
          "properties": {
            "replacements": {
              "$ref": "#/$defs/step1/$defs/step0/properties/replacements"
            },
            "unresolved": {
              "$ref": "#/$defs/step1/$defs/step0/properties/unresolved"
            },
            "warnings": {
              "$ref": "#/$defs/step1/$defs/step0/properties/warnings"
            },
            "status": {
              "$ref": "#/$defs/step1/$defs/step0/properties/status"
